--工程名字
PROJECT_NAME = "quanta"

--目标名字
TARGET_NAME = "quanta"

----工程类型: static/dynamic/exe
PROJECT_TYPE = "exe"

--需要定义的选项
DEFINES = {
}

--需要的include目录
INCLUDES = {
    "../../extend/lua/lua",
    "../../extend/luakit/include"
}

--需要连接的库文件
LIBS = {
    "lua"
}

--LINUX需要连接的库文件
LINUX_LIBS = {
}

EXCLUDE_FILE = {
    "dynmic.cpp"
}

--依赖项目
DEPS = {
    "luabus"
}

--分组定义
GROUP = "core"
